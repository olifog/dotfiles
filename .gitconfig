[init]
	defaultBranch = main
[user]
	email = oliverfogelin@gmail.com
	name = Oliver Fogelin
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
[diff]
	colorMoved = default
[merge]
	conflictStyle = zdiff3
[fetch]
	prune = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
